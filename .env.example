# Gemini API key used by the frontend (see README).
GEMINI_API_KEY=

# The backend API's base URL. The backend lives in its own repo
# (https://github.com/giteshnegi06/cafeBackend), deployed separately.
#   Local dev:  http://localhost:3001/api  (run `npm run dev` in cafeBackend)
#   Production: https://cafe-backend-sigma-pearl.vercel.app/api
VITE_API_URL=https://cafe-backend-sigma-pearl.vercel.app/api

# Realtime updates (Pusher Channels). Client-side key/cluster only — no
# secret here. Must match the backend's PUSHER_KEY/PUSHER_CLUSTER. Without
# these the frontend falls back to REST polling every few seconds.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
